{
  "name": "extract-lab",
  "version": "0.2.0",
  "description": "An open-source workbench for LLM document extraction: try prompts, schemas, and models, and check them against correct answers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anujparekh18/extract-lab.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "build": "vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc --noEmit",
    "convex": "convex dev",
    "convex:codegen": "convex codegen",
    "test": "bun test",
    "smoke": "bun --env-file=.env.local scripts/smoke.ts",
    "mcp": "bun mcp/server.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/openai": "^4.0.78",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "ai": "^7.0.118",
    "convex": "^1.46.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
